{
  "name": "opencode-web-for-ide",
  "displayName": "OpenCode Web IDE (Unofficial)",
  "description": "OpenCode Web IDE complements and is based on the OpenCode agent project developed by sst-dev, bringing the OpenCode web experience into VS Code and VSCodium.",
  "version": "1.14.43",
  "publisher": "UWEsmith",
  "author": "sst-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "webview",
    "vscode",
    "vscodium"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:opencode.sidebar",
    "onCommand:opencode.addFilepathToTerminal",
    "onCommand:opencode.addToOpenCode",
    "onCommand:opencode.addFilesToOpenCode",
    "onCommand:opencode.attachToOpenCode",
    "onCommand:opencode.attachFilesToOpenCode",
    "onCommand:opencode.sendTerminalToOpenCode",
    "onCommand:opencode.pasteIntoOpenCode",
    "onCommand:opencode.copyInOpenCode",
    "onCommand:opencode.cutInOpenCode",
    "onCommand:opencode.selectAllInOpenCode",
    "onCommand:opencode.undoInOpenCode",
    "onCommand:opencode.redoInOpenCode"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "OpenCode Web IDE",
      "type": "object",
      "properties": {
        "opencodeWeb.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the OpenCode executable. Leave empty to detect OpenCode in PATH and standard installation locations."
        }
      }
    },
    "commands": [
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "Add Filepath to Terminal"
      },
      {
        "command": "opencode.addToOpenCode",
        "title": "Add to OpenCode"
      },
      {
        "command": "opencode.addFilesToOpenCode",
        "title": "Add Files to OpenCode..."
      },
      {
        "command": "opencode.attachToOpenCode",
        "title": "Attach to OpenCode"
      },
      {
        "command": "opencode.attachFilesToOpenCode",
        "title": "Attach Files to OpenCode..."
      },
      {
        "command": "opencode.sendTerminalToOpenCode",
        "title": "Send Terminal Contents to OpenCode"
      },
      {
        "command": "opencode.pasteIntoOpenCode",
        "title": "Paste into OpenCode"
      },
      {
        "command": "opencode.copyInOpenCode",
        "title": "Copy in OpenCode"
      },
      {
        "command": "opencode.cutInOpenCode",
        "title": "Cut in OpenCode"
      },
      {
        "command": "opencode.selectAllInOpenCode",
        "title": "Select All in OpenCode"
      },
      {
        "command": "opencode.undoInOpenCode",
        "title": "Undo in OpenCode"
      },
      {
        "command": "opencode.redoInOpenCode",
        "title": "Redo in OpenCode"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "opencode.attachToOpenCode",
          "group": "navigation@89"
        },
        {
          "command": "opencode.addToOpenCode",
          "group": "navigation@90"
        }
      ],
      "terminal/context": [
        {
          "command": "opencode.sendTerminalToOpenCode",
          "group": "3_edit@10"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode",
          "title": "OpenCode",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "opencode": [
        {
          "id": "opencode.sidebar",
          "name": "OpenCode",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "opencode: Insert At-Mentioned",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      },
      {
        "command": "opencode.attachToOpenCode",
        "title": "opencode: Attach to OpenCode",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "win": "ctrl+alt+a",
        "linux": "ctrl+alt+a"
      },
      {
        "command": "opencode.attachFilesToOpenCode",
        "title": "opencode: Attach Files to OpenCode",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "win": "ctrl+shift+a",
        "linux": "ctrl+shift+a"
      },
      {
        "command": "opencode.addToOpenCode",
        "title": "opencode: Send to OpenCode",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "win": "ctrl+alt+s",
        "linux": "ctrl+alt+s"
      },
      {
        "command": "opencode.addFilesToOpenCode",
        "title": "opencode: Send Files to OpenCode",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s",
        "win": "ctrl+alt+shift+s",
        "linux": "ctrl+alt+shift+s"
      },
      {
        "command": "opencode.pasteIntoOpenCode",
        "title": "opencode: Paste into OpenCode",
        "key": "cmd+v",
        "mac": "cmd+v",
        "when": "isMac && webviewId == 'opencode.sidebar'"
      },
      {
        "command": "opencode.copyInOpenCode",
        "title": "opencode: Copy in OpenCode",
        "key": "cmd+c",
        "mac": "cmd+c",
        "when": "isMac && webviewId == 'opencode.sidebar'"
      },
      {
        "command": "opencode.cutInOpenCode",
        "title": "opencode: Cut in OpenCode",
        "key": "cmd+x",
        "mac": "cmd+x",
        "when": "isMac && webviewId == 'opencode.sidebar'"
      },
      {
        "command": "opencode.selectAllInOpenCode",
        "title": "opencode: Select All in OpenCode",
        "key": "cmd+a",
        "mac": "cmd+a",
        "when": "isMac && webviewId == 'opencode.sidebar'"
      },
      {
        "command": "opencode.undoInOpenCode",
        "title": "opencode: Undo in OpenCode",
        "key": "cmd+z",
        "mac": "cmd+z",
        "when": "isMac && webviewId == 'opencode.sidebar'"
      },
      {
        "command": "opencode.redoInOpenCode",
        "title": "opencode: Redo in OpenCode",
        "key": "shift+cmd+z",
        "mac": "shift+cmd+z",
        "when": "isMac && webviewId == 'opencode.sidebar'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "tsc -p . --outDir out && node --test out/pathUtils.test.js out/opencodeExecutable.test.js out/opencodeCompatibility.test.js out/opencodeBootstrap.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
